ูตัวอย่าง\u003c/a>\n\t\t\t\u003cbutton type=\"button\" class=\"btn btn-primary btn-update-form-step-2\">\u003ci class=\"fa-solid fa-check\">\u003c/i> บันทึก\u003c/button>\n\t\t\u003c/div>\n\t\u003c/form>\n\n\t\u003cform id=\"frm_preview_cert\" name=\"frm_preview_cert\" target=\"_blank\" action=\"/learnext/admin/course/edit/6/certificate/preview\" method=\"POST\">\n\t\t\u003cinput type=\"hidden\" name=\"_token\" value=\"zsS0iOfiVrnp1vU2JEGfP06KtyJQfdlDU9lAY6g5\" autocomplete=\"off\">\t\t\u003cinput type=\"hidden\" id=\"certificate_id_preview\" name=\"certificate_id_preview\">\n\t\t\n\t\u003c/form>\n\u003c/div>\n\u003cstyle>\n\t/* ตัวเลือกแม่แบบใบประกาศ (ขั้น 2.3) */\n\t.cert-tpl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;max-width:820px;}\n\t.cert-tpl-card{position:relative;display:block;margin:0;border:2px solid #e3e6f0;border-radius:8px;overflow:hidden;cursor:pointer;background:#fff;transition:border-color .15s,box-shadow .15s;}\n\t.cert-tpl-card:hover{border-color:#9db2ea;}\n\t.cert-tpl-card.is-selected{border-color:#0d6efd;box-shadow:0 0 0 3px rgba(13,110,253,.15);}\n\t.cert-tpl-card input{position:absolute;opacity:0;pointer-events:none;}\n\t.cert-tpl-card img{display:block;width:100%;aspect-ratio:1123/794;object-fit:cover;background:#f4f6f9;}\n\t.cert-tpl-name{padding:6px 10px;font-size:12.5px;border-top:1px solid #eef1f6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n\t.cert-tpl-name i{color:#c7ced8;}\n\t.cert-tpl-card.is-selected .cert-tpl-name{color:#0d6efd;font-weight:600;}\n\t.cert-tpl-card.is-selected .cert-tpl-name i{color:#0d6efd;}\n\t/* ผู้ลงนามของรายวิชา - การ์ดละช่องลายเซ็นของแม่แบบที่เลือก */\n\t.cert-signer-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;max-width:820px;}\n\t.cert-signer{border:1px solid #e3e6f0;border-radius:8px;padding:12px;background:#fff;min-width:0;}\n\t.cert-signer-title{font-weight:600;font-size:13px;margin-bottom:8px;}\n\t.cert-signer-default{margin-top:8px;font-size:12.5px;color:#6b7a90;overflow-wrap:anywhere;}\n\t.cert-signer-custom{margin-top:10px;}\n\t.cert-signer-img{display:flex;align-items:center;justify-content:center;height:72px;border:1px dashed #ccd3de;border-radius:6px;background:#f8f9fb;margin-bottom:8px;overflow:hidden;}\n\t.cert-signer-img img{max-width:100%;max-height:64px;object-fit:contain;}\n\t.cert-signer-img.is-loading{opacity:.5;}\n\t.cert-signer-noimg{font-size:12px;color:#8a94a6;padding:0 10px;text-align:center;}\n\t.cert-signer-actions{display:flex;flex-wrap:wrap;gap:6px;}\n\t.cert-signer-label{font-size:12.5px;margin-bottom:4px;}\n\u003c/style>\n\t\t\t\u003c!--end: Tab 2/3 - Settings-->\r\n\t\t\t\r\n\t\t\u003c/div>\r\n\r\n\t\t\u003c/div>\r\n\t\u003c/div>\r\n\u003c/div>\r\n\u003c!--/ Step 2-->\r\n\r\n\u003cdiv id=\"modal_preview_certificate\" class=\"modal fade bd-example-modal\" tabindex=\"-1\" role=\"dialog\" aria-hidden=\"true\">\r\n\t\u003cdiv class=\"modal-dialog\">\r\n\t\t\u003cdiv class=\"modal-content\">\r\n\t\t\t\u003cdiv class=\"modal-header\">\r\n\t\t\t\t\u003ch5 class=\"modal-title\">\u003cspan id=\"modal_file_title\">Preview Certificate\u003c/span>\u003c/h5>\r\n\t\t\t\t\u003cbutton type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\">\r\n\t\t\t\t\t\u003cspan aria-hidden=\"true\">&times;\u003c/span>\r\n\t\t\t\t\u003c/button>\r\n\t\t\t\u003c/div>\r\n\t\t\t\u003cdiv class=\"modal-body\">\r\n\t\t\t\tPlease select template, number of signature and click \"Update\" button before preview certificate\r\n\t\t\t\u003c/div>\r\n\t\t\t\u003cdiv class=\"modal-footer\">\r\n\t\t\t\t\u003cdiv class=\"d-flex justify-content-between\">\r\n\t\t\t\t\t\u003cbutton type=\"button\" class=\"btn btn-secondary text-uppercase\" data-dismiss=\"modal\" aria-label=\"Close\">Close\u003c/button>\r\n\t\t\t\t\u003c/div>\r\n\t\t\t\u003c/div>\r\n\t\t\u003c/div>\r\n\t\u003c/div>\r\n\u003c/div>\r\n\r\n\u003cscript type=\"text/javascript\">\r\n$(function() {\r\n\r\n\t$('.sign_date').datepicker({\r\n\t   autoclose: true,\r\n\t   todayBtn: \"linked\",\r\n\t   clearBtn: true,\r\n\t   todayHighlight: true,\r\n\t//    startDate: new Date(),\r\n\t//    showMeridian: false, // 24-hour format\r\n\t// \tminuteStep: 1, // Set the minute step interval\r\n\t// \tdefaultTime: false,\r\n\t\tformat: 'dd/mm/yyyy'\r\n\t   // templates: arrows\r\n\t});\r\n\t$('#main_content_area').delegate('.btn-update-form-step-2', 'click', function(e) {\r\n\t\te.preventDefault();\r\n  \t\te.stopImmediatePropagation();\r\n\t\tif ($(this).closest('form').is('#kt_form_course_step_2_3') && !validateCertSigners()) return false;\r\n\t\t$(this).attr('disabled', true).html('Updating...').addClass('disabled');\r\n\t\tvar step = $(this).closest('form').find('input[name=step]').val();\r\n\t\tvar tab = $(this).closest('form').find('input[name=tab]').val();\r\n\t\t$('#force_tab').val(tab);\r\n\t\tif (step == '2' && tab == '1') {\r\n\t\t\tis_valid = validatePct();\r\n\t\t\tif (!is_valid) {\r\n\t\t\t\t$(this).removeAttr('disabled').text($(this).data('label') || 'Update').removeClass('disabled');\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t}\r\n\t\t$('.alert').remove();\r\n\t\t$(this).attr('disabled', true).addClass('disabled');\r\n\t\t$(this).closest('form').submit();\r\n\t});\r\n\r\n\t// ----- โครงสร้างคะแนน (form_step_2_1) -----\r\n\t$('#main_content_area').delegate('.btn-add-row', 'click', function(e) {\r\n\t\te.preventDefault();\r\n\t\te.stopImmediatePropagation();\r\n\t\tvar $last = $('#panel_scoring .new-row-item:last');\r\n\t\tif ($last.length && $.trim($last.find('.sc-name').val()) === '') {\r\n\t\t\t$last.find('.sc-name').focus();\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tvar tpl = document.getElementById('sc_tpl');\r\n\t\tvar $row = $(tpl.content.firstElementChild.cloneNode(true)).appendTo('#panel_scoring');\r\n\t\t// เกณฑ์ใหม่ = สัดส่วนที่ยังเหลือให้ครบ 100%\r\n\t\tvar left = 100 - scoringTotal();\r\n\t\t$row.find('.ddl-score-pct').val(left > 0 ? left : '');\r\n\t\t$row.find('.sc-name').focus();\r\n\t\tupdateActionDropdown();\r\n\t});\r\n\r\n\t$('#main_content_area').delegate('.btn-remove-row', 'click', function(e) {\r\n\t\te.preventDefault();\r\n\t\te.stopImmediatePropagation();\r\n\t\tvar $row = $(this).closest('.row-item');\r\n\t\tif (($row.hasClass('new-row-item') && $.trim($row.find('.sc-name').val()) === '') || confirm(\"\\u0e25\\u0e1a\\u0e40\\u0e01\\u0e13\\u0e11\\u0e4c\\u0e19\\u0e35\\u0e49? \\u0e23\\u0e32\\u0e22\\u0e01\\u0e32\\u0e23\\u0e1a\\u0e17\\u0e40\\u0e23\\u0e35\\u0e22\\u0e19\\u0e17\\u0e35\\u0e48\\u0e1c\\u0e39\\u0e01\\u0e01\\u0e31\\u0e1a\\u0e40\\u0e01\\u0e13\\u0e11\\u0e4c\\u0e19\\u0e35\\u0e49\\u0e08\\u0e30\\u0e44\\u0e21\\u0e48\\u0e16\\u0e39\\u0e01\\u0e19\\u0e31\\u0e1a\\u0e04\\u0e30\\u0e41\\u0e19\\u0e19\")) {\r\n\t\t\t$row.remove();\r\n\t\t\tupdateActionDropdown();\r\n\t\t}\r\n\t});\r\n\r\n\t$('#main_content_area').delegate('.ddl-score-type', 'change', function() {\r\n\t\tvar icons = { quiz: 'fa-clipboard-check', assignment: 'fa-file-arrow-up', subjective: 'fa-pen-to-square' };\r\n\t\t$(this).siblings('.icon-scoring').find('i').attr('class', 'fa-solid ' + (icons[$(this).val()] || 'fa-circle-question'));\r\n\t});\r\n\r\n\t$('#main_content_area').delegate('.ddl-score-pct', 'input change', function() {\r\n\t\tupdateActionDropdown();\r\n\t});\r\n\r\n\t$('#main_content_area').delegate('#panel_scoring .btn-move-up', 'click', function(e) {\r\n\t\te.preventDefault();\r\n\t\tvar $row = $(this).closest('.row-item');\r\n\t\t$row.insertBefore($row.prev('.row-item'));\r\n\t\tupdateActionDropdown();\r\n\t});\r\n\r\n\t$('#main_content_area').delegate('#panel_scoring .btn-move-down', 'click', function(e) {\r\n\t\te.preventDefault();\r\n\t\tvar $row = $(this).closest('.row-item');\r\n\t\t$row.insertAfter($row.next('.row-item'));\r\n\t\tupdateActionDropdown();\r\n\t});\r\n\r\n\t$('input[name=has_certificate]').trigger('change');\r\n\t$('#main_content_area').delegate('input[name=has_certificate]', 'change', function(e) {\r\n\t\te.preventDefault();\r\n\t\te.stopImmediatePropagation();\r\n\t\tif ($(this).val() !== \"0\")\r\n\t\t\t$('#panel_manage_certificate').removeClass('d-none');\r\n\t\telse\r\n\t\t\t$('#panel_manage_certificate').addClass('d-none');\r\n\t});\r\n\r\n\r\n\t$('#main_content_area').delegate('input[name=certificate_path]', 'change', function(e) {\r\n\t});\r\n\r\n\t// เลือกแม่แบบใบประกาศ (การ์ดภาพย่อ) - ไฮไลต์การ์ดที่เลือก\r\n\t$('#main_content_area').delegate('input[name=certificate_id]', 'change', function(e) {\r\n\t\t$('.cert-tpl-card').removeClass('is-selected');\r\n\t\t$(this).closest('.cert-tpl-card').addClass('is-selected');\r\n\t\tcertSignerSync();\r\n\t});\r\n\r\n\t// ผู้ลงนามของรายวิชา (การ์ดช่องลายเซ็น) - off ก่อน on เพราะโหลดขั้นนี้ซ้ำได้หลายครั้ง\r\n\t$('#main_content_area')\r\n\t\t.off('.certsig')\r\n\t\t.on('change.certsig', '.cert-signer-mode', certSignerSync)\r\n\t\t.on('change.certsig', '.cert-signer-instructor', function() {\r\n\t\t\tvar $opt = $(this).find('option:selected'), $c = $(this).closest('.cert-signer');\r\n\t\t\tif ($(this).val() === '') return;\r\n\t\t\t$c.find('.cert-signer-name').val($opt.data('name') || '');\r\n\t\t\t$c.find('.cert-signer-position').val($opt.data('position') || '');\r\n\t\t\t$(this).val('');\r\n\t\t})\r\n\t\t.on('click.certsig', '.js-signer-remove', function() {\r\n\t\t\tvar $c = $(this).closest('.cert-signer');\r\n\t\t\t$c.find('.cert-signer-path').val('');\r\n\t\t\tcertSignerImage($c, '');\r\n\t\t})\r\n\t\t.on('change.certsig', '.cert-signer-file', function() {\r\n\t\t\tvar file = this.files && this.files[0], $c = $(this).closest('.cert-signer'), $wrap = $('#cert_signers');\r\n\t\t\tthis.value = '';\r\n\t\t\tif (!file) return;\r\n\t\t\tvar before = { src: $c.find('.cert-signer-img img').attr('src'), path: $c.find('.cert-signer-path').val() };\r\n\t\t\tvar fd = new FormData();\r\n\t\t\tfd.append('file', file);\r\n\t\t\tcertSignerImage($c, URL.createObjectURL(file));\r\n\t\t\t$c.find('.cert-signer-img').addClass('is-loading');\r\n\t\t\t$.ajax({\r\n\t\t\t\turl: $wrap.data('upload'), method: 'POST', data: fd, processData: false, contentType: false, dataType: 'json',\r\n\t\t\t\theaders: { 'X-CSRF-TOKEN': $('meta[name=\"csrf-token\"]').attr('content') },\r\n\t\t\t}).done(function(resp) {\r\n\t\t\t\tif (resp && resp.path) $c.find('.cert-signer-path').val(resp.path);\r\n\t\t\t}).fail(function() {\r\n\t\t\t\tcertSignerImage($c, before.src);\r\n\t\t\t\t$c.find('.cert-signer-path').val(before.path);\r\n\t\t\t\tshowNotifyOnScreen({ notify_type: 'danger', notify_msg: $wrap.data('upload-fail') });\r\n\t\t\t}).always(function() {\r\n\t\t\t\t$c.find('.cert-signer-img').removeClass('is-loading');\r\n\t\t\t});\r\n\t\t});\r\n\r\n\t// Init\r\n\tupdateActionDropdown();\r\n\tcertSignerSync();\r\n});\r\n\r\n// ช่องลายเซ็นตามแม่แบบที่เลือก (ยังไม่เลือก = แม่แบบที่ระบบใช้ให้) / แสดงส่วนกรอกเองเฉพาะช่องที่ตั้งเป็น custom\r\n// แม่แบบไม่มีช่องลายเซ็น: แสดงช่องที่กำหนดเองทั้งหมด + ช่องว่างอีกหนึ่งช่องไว้เพิ่มคน ตัวเลือกมีแค่ ไม่ใช้ / กำหนดเอง\r\nfunction certSignerSync()\r\n{\r\n\tvar $wrap = $('#cert_signers');\r\n\tif (!$wrap.length) return;\r\n\tvar $radio = $('input[name=certificate_id]:checked');\r\n\tif (!$radio.length) $radio = $('input[name=certificate_id][value=\"' + $wrap.data('default-id') + '\"]');\r\n\tvar slots = $radio.closest('.cert-tpl-card').data('slots') || [], bySlot = {}, hasSlots = slots.length > 0, addShown = false;\r\n\t$.each(slots, function(i, s) { bySlot[s.slot] = s; });\r\n\t$wrap.find('.cert-signer').each(function() {\r\n\t\tvar $c = $(this), s = bySlot[$c.data('slot')], $mode = $c.find('.cert-signer-mode'), $tpl = $mode.find('option[value=template]');\r\n\t\t$tpl.text(hasSlots ? $tpl.data('label') : $wrap.data('mode-off'));\r\n\t\t$mode.find('option[value=none]').prop('hidden', !hasSlots);\r\n\t\tif (!hasSlots && $mode.val() === 'none') $mode.val('template');\r\n\t\tvar mode = $mode.val(), show = hasSlots ? !!s : (mode === 'custom' || !addShown);\r\n\t\tif (!hasSlots && mode !== 'custom') addShown = true;\r\n\t\t$c.toggleClass('d-none', !show);\r\n\t\tif (!show) return;\r\n\t\t$c.find('.js-signer-default').text(s ? ([s.name, s.position].filter(Boolean).join(' · ') || $wrap.data('default-none')) : '');\r\n\t\t$c.find('.cert-signer-default').toggleClass('d-none', !s || mode !== 'template');\r\n\t\t$c.find('.cert-signer-custom').toggleClass('d-none', mode !== 'custom');\r\n\t});\r\n\t$wrap.find('.cert-signers-empty').toggleClass('d-none', hasSlots);\r\n}\r\nfunction certSignerImage($c, src)\r\n{\r\n\t$c.find('.cert-signer-img img').attr('src', src || '').toggleClass('d-none', !src);\r\n\t$c.find('.cert-signer-noimg').toggleClass('d-none', !!src);\r\n\t$c.find('.js-signer-remove').toggleClass('d-none', !src);\r\n}\r\nfunction validateCertSigners()\r\n{\r\n\tvar msg = '', $focus = null;\r\n\tif ($('#panel_manage_certificate').hasClass('d-none')) return true;\r\n\t// ช่องที่แม่แบบนี้ไม่ได้ใช้ (ซ่อนอยู่) แต่ค้างเป็นกำหนดเองที่ไม่มีชื่อ - คืนเป็นตามแม่แบบ ไม่ให้บันทึกไม่ผ่านโดยไม่เห็นสาเหตุ\r\n\t$('#cert_signers .cert-signer.d-none').each(function() {\r\n\t\tif ($(this).find('.cert-signer-mode').val() === 'custom' && $.trim($(this).find('.cert-signer-name').val()) === '') $(this).find('.cert-signer-mode').val('template');\r\n\t});\r\n\t$('#cert_signers .cert-signer:not(.d-none)').each(function() {\r\n\t\tvar $c = $(this);\r\n\t\tif ($c.find('.cert-signer-mode').val() === 'custom' && $.trim($c.find('.cert-signer-name').val()) === '') {\r\n\t\t\tmsg = \"\\u0e01\\u0e23\\u0e2d\\u0e01\\u0e0a\\u0e37\\u0e48\\u0e2d\\u0e1c\\u0e39\\u0e49\\u0e25\\u0e07\\u0e19\\u0e32\\u0e21\\u0e02\\u0e2d\\u0e07\\u0e0a\\u0e48\\u0e2d\\u0e07\\u0e25\\u0e32\\u0e22\\u0e40\\u0e0b\\u0e47\\u0e19\\u0e17\\u0e35\\u0e48 :n\".replace(':n', $c.data('slot'));\r\n\t\t\t$focus = $c.find('.cert-signer-name');\r\n\t\t\treturn false;\r\n\t\t}\r\n\t});\r\n\t$('#cert_signers_alert').html(msg ? $('\u003cdiv class=\"alert alert-danger py-2 px-3\" role=\"alert\" style=\"font-size:13.5px;\">\u003c/div>').text(msg) : '');\r\n\tif ($focus) $focus.focus();\r\n\treturn !msg;\r\n}\r\n\r\n// โครงสร้างคะแนน: ปุ่มเลื่อนของแถวแรก/สุดท้าย / หัวตาราง / ยอดรวม % / ปุ่มบันทึก\r\nfunction scoringTotal()\r\n{\r\n\tvar total = 0;\r\n\t$('#panel_scoring .row-scoring-item').each(function() {\r\n\t\ttotal += parseInt($(this).find('.ddl-score-pct').val(), 10) || 0;\r\n\t});\r\n\treturn total;\r\n}\r\nfunction updateActionDropdown()\r\n{\r\n\tvar $rows = $('#panel_scoring .row-scoring-item');\r\n\t$rows.each(function(k) {\r\n\t\t$(this).find('.btn-move-up').prop('disabled', k === 0);\r\n\t\t$(this).find('.btn-move-down').prop('disabled', k === $rows.length - 1);\r\n\t});\r\n\tvar has = $rows.length > 0, total = scoringTotal();\r\n\t$('.sc-head').toggleClass('d-none', !has);\r\n\t$('#sc_empty').toggleClass('d-none', has);\r\n\t$('#sc_total').toggleClass('d-none', !has).toggleClass('is-ok', total === 100).toggleClass('is-bad', total !== 100).find('strong').text(total);\r\n\t// ปุ่มบันทึก: มีแถว หรือเคยมีเกณฑ์แล้วลบออกหมด (ต้องบันทึกเพื่อลบจริง)\r\n\tif (has || $('#subtab_content_step_2_1').data('had-rows')) {\r\n\t\t$('#subtab_content_step_2_1 .panel-button').removeClass('d-none').addClass('d-flex');\r\n\t}\r\n}\r\n\r\n\r\nfunction validatePct()\r\n{\r\n\tvar $rows = $('#panel_scoring .row-scoring-item'), total = scoringTotal(), msg = '';\r\n\t$rows.each(function() {\r\n\t\tvar name = $.trim($(this).find('.sc-name').val()), pct = parseInt($(this).find('.ddl-score-pct').val(), 10) || 0;\r\n\t\tif (name !== '' && (pct \u003c 1 || pct > 100)) { msg = \"\\u0e02\\u0e49\\u0e2d\\u0e21\\u0e39\\u0e25\\u0e40\\u0e01\\u0e13\\u0e11\\u0e4c \\u201c:title\\u201d \\u0e44\\u0e21\\u0e48\\u0e16\\u0e39\\u0e01\\u0e15\\u0e49\\u0e2d\\u0e07 - \\u0e15\\u0e23\\u0e27\\u0e08\\u0e1b\\u0e23\\u0e30\\u0e40\\u0e20\\u0e17\\u0e41\\u0e25\\u0e30\\u0e2a\\u0e31\\u0e14\\u0e2a\\u0e48\\u0e27\\u0e19 (1-100%)\".replace(':title', name); return false; }\r\n\t});\r\n\tif (!msg && $rows.length > 0 && total !== 100) {\r\n\t\tmsg = \"\\u0e23\\u0e27\\u0e21\\u0e17\\u0e38\\u0e01\\u0e40\\u0e01\\u0e13\\u0e11\\u0e4c\\u0e15\\u0e49\\u0e2d\\u0e07\\u0e44\\u0e14\\u0e49 100% (\\u0e15\\u0e2d\\u0e19\\u0e19\\u0e35\\u0e49 :n%)\".replace(':n', total);\r\n\t}\r\n\tif (msg) {\r\n\t\t$('#sc_alert').html($('\u003cdiv class=\"alert alert-danger py-2 px-3\" role=\"alert\" style=\"font-size:13.5px;\">\u003c/div>').text(msg));\r\n\t\treturn false;\r\n\t}\r\n\t$('#sc_alert').empty();\r\n\treturn true;\r\n}\r\n\r\nfunction setCertMode(e) {\r\n\tvar id = $(e).data('id');\r\n\tvar status = $(e).data('status');\r\n\tif ($(e).val() == '0') {\r\n\t\t$('#panel_manage_certificate').addClass('d-none');\r\n\t\t$('#panel_manage_certificate_btn').addClass('d-none').removeClass('d-flex');\r\n\t}\r\n\telse {\r\n\t\t$('#panel_manage_certificate').removeClass('d-none');\r\n\t\t$('#panel_manage_certificate_btn').removeClass('d-none').addClass('d-flex');\r\n\t}\r\n\r\n\t$.ajaxSetup({\r\n\t    headers: {\r\n\t        'X-CSRF-TOKEN': $('meta[name=\"csrf-token\"]').attr('content')\r\n\t    }\r\n\t});\r\n\t$.ajax({\r\n\t\turl:\"/learnext/admin/course/step-2/set-cert-mode\",\r\n\t\tmethod: 'POST',\r\n\t\tdata: { id: id, has_certificate: $(e).val() },\r\n\t\tdataType: 'json',\r\n\t}).done(function(resp) {\r\n\t\t$('.alert').alert('close');\r\n\t\tif (resp.status == '200') {\r\n\t\t\teval(resp.js);\r\n\t\t\tshowNotifyOnScreen(resp);\r\n\t\t}\r\n\t});\r\n}\r\n\r\nfunction previewCert() {\r\n\t// ดูตัวอย่างด้วยแม่แบบที่เลือกอยู่ (ไม่ต้องกด Update ก่อน) - ไม่เลือกก็ใช้แม่แบบของรายวิชา/แม่แบบแรกที่ใช้ได้\r\n\tvar certificate_id = $('input[name=certificate_id]:checked').val() || '';\r\n\t$('#certificate_id_preview').val(certificate_id);\r\n\t// ผู้ลงนามที่กำลังแก้ (ยังไม่บันทึก) ไปด้วย\r\n\t$('#frm_preview_cert .js-signer-copy').remove();\r\n\t$('#kt_form_course_step_2_3').find('[name^=\"signers[\"]').each(function() {\r\n\t\t$('\u003cinput type=\"hidden\" class=\"js-signer-copy\">').attr('name', this.name).val($(this).val()).appendTo('#frm_preview_cert');\r\n\t});\r\n\t