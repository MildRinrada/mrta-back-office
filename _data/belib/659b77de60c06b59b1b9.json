can\">\u003c/i> Delete\u003c/a>\u003c/li>\n                    \u003c/ul>\n                \u003c/div>","DT_RowIndex":5},{"id":18,"user_org_id":1,"product_main_id":4,"product_magazine_title_id":null,"slug":"6a4b690ec4508","ref_source":null,"ref_id":null,"data_ref":null,"title":"นอนเปลี่ยนชีวิต","copy_title":null,"description":"","preview":null,"cover_file_path":"https://readery.co/media/catalog/product/cache/1/small_image/360x/17f82f742ffe127f42dca9de82fb58b1/s/c/screen_shot_2562-12-22_at_9.09.12_pm.png","cover_file_size":null,"publisher_id":24,"publisher_internal_id":null,"total_view":0,"total_share":0,"total_download":0,"rating_star":"0.0","published_at":null,"is_locked":0,"data_fields":{"title":"นอนเปลี่ยนชีวิต","description":"การนอนหลับ คือกลไกอัศจรรย์ที่ธรรมชาติรังสรรค์ให้มนุษย์ และเป็นหนึ่งในสามเสาหลักแห่งสุขภาพดี  ควบคู่กับอาหารและการออกกำลังกาย ทว่าน้อยคนจะเข้าใจปริศนาเบื้องหลังการนอนหลับและการฝัน  และมักมองข้ามกิจวัตรยามค่ำคืนอันแสนสำคัญ ซึ่งเป็นกุญแจสู่คุณภาพชีวิตและอายุขัยที่ยืนยาว  \n\nแมตธิว วอล์กเกอร์ ศาสตราจารย์ด้านประสาทวิทยาศาสตร์และจิตวิทยา  และผู้ก่อตั้งห้องปฏิบัติการด้านการนอนหลับ มหาวิทยาลัยแคลิฟอร์เนียเบิร์กลีย์  จะนำคุณดำดิ่งสู่ห้วงนิทราอันเร้นลับ ไขปริศนาเบื้องหลังการหลับและการฝันที่ซ่อนอยู่ในสมอง  ตลอดจนผลกระทบต่อการเรียนรู้ ความจำ และความเชื่อมโยงกับโรคร้ายอย่างอัลไซเมอร์ เบาหวาน หรือมะเร็ง  พร้อมตอบสารพัดข้อข้องใจเรื่องการนอนหลับ เช่น คาเฟอีนและแอลกอฮอล์ส่งผลอย่างไรต่อการนอนหลับ?  ความฝันช่วยเยียวยาบาดแผลทางอารมณ์ได้อย่างไร? เหตุใดวัยรุ่นจึงชอบนอนดึกและตื่นสาย?  ยานอนหลับคือตัวช่วยหรือตัวร้ายที่บ่อนทำลายการหลับกันแน่? \n\nหนังสือเล่มนี้คือคู่มือการนอนหลับฉบับสมบูรณ์ที่มีข้อมูลทางวิทยาศาสตร์รองรับ  ซึ่งไม่เพียงถ่ายทอดเคล็ดลับที่ช่วยให้คุณนอนหลับอย่างมีคุณภาพทุกคืน แต่ยังฟื้นฟูศักยภาพ ในการใช้ชีวิตอย่างเปี่ยมพลังในทุกๆ วัน โดยไม่ต้องอาศัยยาบำรุงหรือเทคโนโลยีการแพทย์ล้ำสมัยใดๆ  ทั้งหมดนี้เริ่มต้นได้ง่ายๆ เพียงแค่คุณก้าวขึ้นเตียง ปิดไฟ แล้วจมดิ่งสู่ห้วงการหลับใหลที่จะเปลี่ยนชีวิตคุณ","author":"John Doe","total_pages":240,"isbn":"978-3-16-148410-0"},"data_marc21":null,"default_copy_data":null,"remark":null,"is_choice":0,"is_recommended":0,"is_promoted":0,"is_hide":0,"is_restricted_ip":0,"weight":0,"status":1,"created_by":null,"updated_by":null,"created_at":"2026-07-06T08:36:30.000000Z","updated_at":"2026-07-06T08:36:31.000000Z","created_date":"06/07/2026","updated_date":"06/07/2026","published_date":null,"product_copies":[{"id":18,"user_org_id":1,"product_id":18,"product_copy_type_id":1,"uniqid":"6a4b690f47467","barcode":null,"ref_source":null,"ref_id":null,"data_ref":null,"data_info":null,"from_bookdose":0,"is_licensed":1,"is_digital":1,"concurrence":1,"key":null,"copy_file_path":null,"copy_file_size":null,"copy_file_ext":null,"external_source_url":null,"external_source_embed":null,"mobile_folder_path":null,"call_number":null,"call_number_1":null,"call_number_2":null,"call_number_3":null,"call_number_4":null,"call_number_5":null,"call_number_other":null,"cover_price":null,"published_at":null,"borrowing_status":0,"last_borrowed_at":null,"last_borrowed_by":null,"remark":null,"remark_2":null,"status":1,"created_by":null,"updated_by":null,"created_at":"2026-07-06T08:36:31.000000Z","updated_at":"2026-07-06T08:36:31.000000Z"}],"publisher":{"id":24,"user_org_id":1,"slug":"bookscape","name":"Bookscape","logo_file_path":null,"logo_file_size":null,"contact_email":null,"address":null,"remark":null,"status":1,"created_by":null,"updated_by":null,"created_at":"2026-07-06T08:36:30.000000Z","updated_at":"2026-07-06T08:36:30.000000Z"},"creator":[],"cover_html":"\u003cimg src=\"https://readery.co/media/catalog/product/cache/1/small_image/360x/17f82f742ffe127f42dca9de82fb58b1/s/c/screen_shot_2562-12-22_at_9.09.12_pm.png\" class=\"\" style=\"width:95px;height:135px;object-fit:cover;border-radius:4px;\" alt=\"นอนเปลี่ยนชีวิต\" loading=\"lazy\" decoding=\"async\" onerror=\"this.src='/belib/client/default/images/placeholder/default-ebook.png'\" />","barcode":"-","call_number":"-","creator_names":"-","publisher_name":"-","publi