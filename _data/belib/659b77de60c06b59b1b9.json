                   \u003cbutton class=\"btn btn-sm btn-light\" type=\"button\" data-bs-toggle=\"dropdown\">\u003ci class=\"fa-solid fa-ellipsis-vertical\">\u003c/i>\u003c/button>\n                    \u003cul class=\"dropdown-menu dropdown-menu-end shadow-sm\">\n                        \u003cli>\u003ca class=\"dropdown-item startpreload\" href=\"/belib/admin/product/ebook/13/edit\">\u003ci class=\"fa-regular fa-pen-to-square\">\u003c/i> Edit\u003c/a>\u003c/li>\n                        \u003cli>\u003chr class=\"dropdown-divider\">\u003c/li>\n                        \u003cli>\u003ca class=\"dropdown-item text-danger\" href=\"javascript:;\" data-id=13 data-title=\"อิคิไก\" onClick=\"deleteItem(this)\">\u003ci class=\"fa-regular fa-trash-can\">\u003c/i> Delete\u003c/a>\u003c/li>\n                    \u003c/ul>\n                \u003c/div>","DT_RowIndex":1},{"id":14,"user_org_id":1,"product_main_id":4,"product_magazine_title_id":null,"slug":"6a4b690ebef0f","ref_source":null,"ref_id":null,"data_ref":null,"title":"วิถีบันทึกแบบบูโจ (ปกแดง)","copy_title":null,"description":"","preview":null,"cover_file_path":"https://readery.co/media/catalog/product/cache/1/small_image/360x/17f82f742ffe127f42dca9de82fb58b1/9/7/9786168221327-_.jpeg","cover_file_size":null,"publisher_id":24,"publisher_internal_id":null,"total_view":0,"total_share":0,"total_download":0,"rating_star":"0.0","published_at":null,"is_locked":0,"data_fields":{"title":"วิถีบันทึกแบบบูโจ (ปกแดง)","description":"ในยุคที่เทคโนโลยีแทรกซึมเข้ามาในทุกซอกมุมของชีวิต และเราค้นหาทุกคำตอบได้เพียงปลายนิ้ว เรากลับปล่อยให้คำถามสำคัญอย่างความหมายของชีวิตเราเองหล่นหาย เราหลงลืมอดีตและประสบการณ์อันทรงคุณค่า เราวิ่งไล่ตามจังหวะชีวิตในปัจจุบัน ทว่าสะดุดล้มซ้ำแล้วซ้ำเล่าเพราะข้อมูลและภาระหน้าที่มากมายที่กองไร้ระเบียบ โลกยุคใหม่กลืนกินเราจนไม่เหลือเวลาและเรี่ยวแรงจะวางแผนถึงอนาคตที่เราวาดฝันอีกต่อไป \n\nไรเดอร์ แคร์รอลล์ ได้คิดค้นระบบบันทึกแบบ &amp;ldquo;บุลเล็ตเจอร์นัล&amp;rdquo; หรือ &amp;ldquo;บูโจ&amp;rdquo; ซึ่งกลายเป็นกระแสโด่งดังทั่วโลก และนำทางให้คนจำนวนมากกลับมาควบคุมชีวิตตนเองได้อีกครั้ง ผ่านเครื่องมืออนาล็อกที่จะช่วยจัดระเบียบชีวิตและการทำงานในยุคดิจิทัล เพื่อให้คุณทำงานน้อยลงแต่ประสบความสำเร็จมากขึ้น จัดการสารพัดข้อมูลที่อัดแน่นในหัว และโฟกัสกับสิ่งที่สำคัญต่อชีวิตอย่างแท้จริง \n\nThe Bullet Journal Method: วิถีบันทึกแบบบูโจ เหมาะสำหรับใครก็ตามที่อยากจัดระเบียบชีวิต นักสร้างสรรค์ที่ต้องการกรอบชัดเจน หรือคนที่กำลังค้นหาเป้าหมายของตนท่ามกลางกระแสดิจิทัลอันท่วมท้น หนังสือเล่มนี้จะเปลี่ยนคุณจากที่เคยเป็นแค่ผู้โดยสาร ให้กลายเป็นกัปตันที่ควบคุมชีวิตได้ดั่งใจปรารถนา ผ่านการบันทึกอดีต จัดระเบียบปัจจุบัน และออกแบบอนาคตด้วยมือคุณเอง","author":"John Doe","total_pages":316,"isbn":"978-3-16-148410-0"},"data_marc21":null,"default_copy_data":null,"remark":null,"is_choice":0,"is_recommended":0,"is_promoted":0,"is_hide":0,"is_restricted_ip":0,"weight":0,"status":1,"created_by":null,"updated_by":null,"created_at":"2026-07-06T08:36:30.000000Z","updated_at":"2026-07-06T08:36:31.000000Z","created_date":"06/07/2026","updated_date":"06/07/2026","published_date":null,"product_copies":[{"id":14,"user_org_id":1,"product_id":14,"product_copy_type_id":1,"uniqid":"6a4b690f3c425","barcode":null,"ref_source":null,"ref_id":null,"data_ref":null,"data_info":null,"from_bookdose":0,"is_licensed":1,"is_digital":1,"concurrence":1,"key":null,"copy_file_path":null,"copy_file_size":null,"copy_file_ext":null,"external_source_url":null,"external_source_embed":null,"mobile_folder_path":null,"call_number":null,"call_number_1":null,"call_number_2":null,"call_number_3":null,"call_number_4":null,"call_number_5":null,"call_number_other":null,"cover_price":null,"published_at":null,"borrowing_status":0,"last_borrowed_at":null,"last_borrowed_by":null,"remark":null,"remark_2":null,"status":1,"created_by":null,"updated_by":null,"created_at":"2026-07-06T08:36:31.000000Z","updated_at":"2026-07-06T08:36:31.000000Z"}],"publisher":{"id":24,"user_org_id":1,"slug":"bookscape","name":"Bookscape","logo_file_path":null,"logo_file_size":null,"contac