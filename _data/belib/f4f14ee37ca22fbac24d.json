{"status":200,"msg":"","result":[],"html":"\u003cdiv id=\"panel_field_categories\">\n\t\t\u003cselect id=\"ts_article_categories\" name=\"article_categories[]\" multiple>\n\t\t\t\t\t\u003c/select>\n\n\t\t\t\u003cdiv class=\"mt-1\" style=\"font-size:11px;color:var(--text-2);\">ยังไม่มีการสร้างหมวดหมู่ไว้ กรุณา\n\t\t\t\u003ca href=\"javascript:void(0);\" onclick=\"addNewCategory()\">\u003cstrong>คลิกที่นี่เพื่อเพิ่มหมวดหมู่ใหม่\u003c/strong>\u003c/a>\n\t\t\u003c/div>\n\t\u003c/div>\n\n\n\u003cscript>\n\t(function() {\n\t\tfunction initArticleCategoriesTomSelect() {\n\t\t\tvar el = document.getElementById('ts_article_categories');\n\t\t\tif (!el) return;\n\t\t\tif (el.tomselect) el.tomselect.destroy();\n\t\t\tnew TomSelect(el, {\n\t\t\t\tplugins: ['remove_button'],\n\t\t\t\tmaxOptions: null,\n\t\t\t\tplaceholder: \"\\u0e40\\u0e25\\u0e37\\u0e2d\\u0e01\\u0e2b\\u0e21\\u0e27\\u0e14\\u0e2b\\u0e21\\u0e39\\u0e48...\",\n\t\t\t});\n\t\t}\n\t\tif (document.readyState === 'loading') {\n\t\t\tdocument.addEventListener('DOMContentLoaded', initArticleCategoriesTomSelect);\n\t\t} else {\n\t\t\tinitArticleCategoriesTomSelect();\n\t\t}\n\t})();\n\u003c/script>\n"}